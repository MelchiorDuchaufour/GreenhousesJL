v -3.000000 -3.000000 0.000000
v -3.000000 3.000000 0.000000
v -3.000000 3.000000 5.000000
v -3.000000 0.000000 6.732051
v -3.000000 -3.000000 5.000000
f 18 19 20
f 18 20 21
f 18 21 22

# roof_south — roof
g roof_roof_south
v -3.000000 -3.000000 5.000000
v 3.000000 -3.000000 5.000000
v 3.000000 0.000000 6.732051
v -3.000000 0.000000 6.732051
f 23 24 25
f 23 25 26

# roof_north — roof
g roof_roof_north
v -3.000000 0.000000 6.732051
v 3.000000 0.000000 6.732051
v 3.000000 3.000000 5.000000
v -3.000000 3.000000 5.000000
f 27 28 29
f 27 29 30

# pv_strip_1 — panel
g panel_pv_strip_1
v -2.000000 -2.725000 5.216506
v -1.000000 -2.725000 5.216506
v -1.000000 -0.325000 6.602147
v -2.000000 -0.325000 6.602147
f 31 32 33
f 31 33 34

