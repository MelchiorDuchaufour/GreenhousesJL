# Savona greenhouse shell for pao.html overlay
# pv_config = no_pv
# 7 polygons : floor, 4 walls, 2 roof slopes (+ 3 PV strips if config != no_pv)

# floor — floor
g floor_floor
v -3.000000 -3.000000 0.000000
v 3.000000 -3.000000 0.000000
v 3.000000 3.000000 0.000000
v -3.000000 3.000000 0.000000
f 1 2 3
f 1 3 4

# wall_south — wall_glass
g wall_glass_wall_south
v -3.000000 -3.000000 0.000000
v 3.000000 -3.000000 0.000000
v 3.000000 -3.000000 5.000000
v -3.000000 -3.000000 5.000000
f 5 6 7
f 5 7 8

# wall_north — wall_glass
g wall_glass_wall_north
v -3.000000 3.000000 0.000000
v 3.000000 3.000000 0.000000
v 3.000000 3.000000 5.000000
v -3.000000 3.000000 5.000000
f 9 10 11
f 9 11 12

# wall_east — wall_glass
g wall_glass_wall_east
v 3.000000 -3.000000 0.000000
v 3.000000 3.000000 0.000000
v 3.000000 3.000000 5.000000
v 3.000000 0.000000 6.732051
v 3.000000 -3.000000 5.000000
f 13 14 15
f 13 15 16
f 13 16 17

# wall_west — wall_glass
g wall_glass_wall_west
v -3.000000 -3.000000 0.000000
v -3.000000 3.000000 0.000000
v -3.000000 3.000000 5.000000
v -3.000000 0.000000 6.732051
v -3.000000 -3.000000 5.000000
f 18 19 20
